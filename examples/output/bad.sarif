                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "entry": "WETH on arbitrum"
          }
        },
        {
          "ruleId": "staleness-too-long",
          "ruleIndex": 7,
          "level": "warning",
          "message": {
            "text": "Asset WETH on arbitrum accepts answers up to 172,800 seconds (48 hours) old, but the configuration gives its feed a heartbeat of 86,400 seconds (24 hours); with the margin of 10 percent the limit is 95,040 seconds. An answer older than that is one the feed should already have replaced, and liquidations and borrows go on at a price that may be gone. Fix: Set maxStaleness to the heartbeat of the feed on this network plus a small margin, or record why the protocol accepts older answers."
          },
          "locations": [
