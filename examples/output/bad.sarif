        {
          "ruleId": "answer-positive-unchecked",
          "ruleIndex": 17,
          "level": "warning",
          "message": {
            "text": "The answer checks of asset WETH on arbitrum do not list answerPositive, so an answer of 0 or below would be used as a price; a feed that was shut down gives 0 from latestAnswer. This is a best practice of this tool, not a rule in the Chainlink pages on Data Feeds or on ethereum.org. Fix: Revert on an answer of 0 or below, and list answerPositive in answerChecks."
          },
